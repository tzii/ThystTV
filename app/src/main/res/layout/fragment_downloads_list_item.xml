<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/cardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/thumbnail"
            style="@style/Thumbnail"
            app:layout_constraintBottom_toTopOf="@id/progressBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Dims an unfinished download's picture so it doesn't read as ready to play. -->
        <View
            android:id="@+id/statusScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#4D000000"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintStart_toStartOf="@id/thumbnail"
            app:layout_constraintTop_toTopOf="@id/thumbnail" />

        <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
            android:id="@+id/date"
            style="@style/ThumbnailItem"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Uploaded: July 16" />

        <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
            android:id="@+id/downloadDate"
            style="@style/ThumbnailItem"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Downloaded: August 7" />

        <!-- Both dates share one row when they fit and wrap to two rows on narrow cards. -->
        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            app:constraint_referenced_ids="date,downloadDate"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="8dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="2dp"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintStart_toStartOf="@id/thumbnail" />

        <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
            android:id="@+id/duration"
            style="@style/ThumbnailItem"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="13:37" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="top|end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
                android:id="@+id/sourceStart"
                style="@style/ThumbnailItem"
                tools:text="13:37:69" />

            <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
                android:id="@+id/sourceEnd"
                style="@style/ThumbnailItem"
                tools:layout_marginTop="5dp"
                tools:text="69:13:37" />

            <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
                android:id="@+id/type"
                style="@style/ThumbnailItem"
                tools:layout_marginTop="5dp"
                tools:text="type" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/spoilerReveal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_spoiler_reveal"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintStart_toStartOf="@id/thumbnail"
            app:layout_constraintTop_toTopOf="@id/thumbnail"
            app:tint="@android:color/white"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_visibility_high"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/downloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_download_status"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/thumbnail"
            tools:text="Downloading: 24% · Chat: 40%"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/downloadProgressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintBottom_toBottomOf="@id/thumbnail"
            app:layout_constraintEnd_toEndOf="@id/thumbnail"
            app:layout_constraintStart_toStartOf="@id/thumbnail"
            app:trackColor="#59FFFFFF"
            app:trackCornerRadius="0dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="4dp"
            tools:progress="24"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thumbnail"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/userImage"
            style="@style/UserPicture"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thumbnail"
            app:layout_constraintVertical_bias="0.0"
            tools:src="@tools:sample/backgrounds/scenic"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/options"
            app:layout_constraintStart_toEndOf="@id/userImage"
            app:layout_constraintTop_toBottomOf="@id/thumbnail">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:visibility="gone"
                tools:text="@sample/videos.json/vods/title"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:text="@sample/videos.json/vods/channel/name"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/gameName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:text="@sample/videos.json/vods/game"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/options"
            style="?android:attr/actionOverflowButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thumbnail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>