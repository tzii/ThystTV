<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/slidingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.github.andreyasadchy.xtra.ui.view.PlayerLayout
            android:id="@+id/playerLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/aspectRatioFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <SurfaceView
                    android:id="@+id/playerSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <TextView
                android:id="@+id/castStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/cast_playing_remotely"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:visibility="gone" />

            <androidx.media3.ui.SubtitleView
                android:id="@+id/subtitleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/bufferingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <include
                android:id="@+id/gestureFeedback"
                layout="@layout/layout_player_gesture_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:visibility="gone" />
            <!-- Subtle YouTube-style white edge rectangle flashed when free zoom
                sticks to Fill. Never intercepts touches; alpha is animated. -->
            <View
                android:id="@+id/pinchFillEdge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@drawable/bg_pinch_fill_edge"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <include
                android:id="@+id/playerControls"
                layout="@layout/player_layout" />

            <View
                android:id="@+id/dragView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.github.andreyasadchy.xtra.ui.view.PlayerLayout>

        <com.github.andreyasadchy.xtra.ui.view.ChatLayout
            android:id="@+id/chatLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?android:colorBackground">

            <LinearLayout
                android:id="@+id/chatLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/chatFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/watchVideo"
                    style="?attr/elevatedButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:text="@string/watch_video"
                    android:textAllCaps="true"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/chatTouchView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.github.andreyasadchy.xtra.ui.view.ChatLayout>

    </FrameLayout>
    <!-- Floating chat: a card over the video plus its tucked tab. The host is
         full screen but takes no touches itself. -->
    <com.github.andreyasadchy.xtra.ui.player.FloatingChatHostLayout
        android:id="@+id/floatingChatHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp">

        <com.github.andreyasadchy.xtra.ui.player.FloatingChatCardView
            android:id="@+id/floating_chat_root"
            android:layout_width="224dp"
            android:layout_height="240dp"
            android:layout_gravity="top|left"
            android:contentDescription="@string/floating_chat"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible">

            <FrameLayout
                android:id="@+id/floating_chat_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Shown with the player controls: move by dragging, also from a button, plus actions. -->
            <com.github.andreyasadchy.xtra.ui.player.FloatingChatHeaderLayout
                android:id="@+id/floatingChatHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="top"
                android:alpha="0"
                android:background="@drawable/bg_floating_chat_header"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="2dp"
                android:visibility="invisible"
                tools:alpha="1"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/floatingChatCompose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/floating_chat_type"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_floating_chat_keyboard"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/floatingChatAppearance"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/floating_chat_appearance"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_floating_chat_text"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/floatingChatTuck"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/floating_chat_tuck"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_floating_chat_tuck"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/floatingChatClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/floating_chat_close"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_floating_chat_close"
                    app:tint="@android:color/white" />
            </com.github.andreyasadchy.xtra.ui.player.FloatingChatHeaderLayout>

            <!-- Quiet handle while the controls are hidden. -->
            <View
                android:id="@+id/floatingChatPill"
                android:layout_width="72dp"
                android:layout_height="24dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_floating_chat_pill"
                android:contentDescription="@string/floating_chat_drag"
                android:importantForAccessibility="no" />

            <!-- Resize from the corner that faces the video; shown with the controls. -->
            <ImageView
                android:id="@+id/floatingChatGrip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|left"
                android:contentDescription="@string/floating_chat_resize"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_floating_chat_grip"
                android:visibility="invisible"
                tools:ignore="RtlHardcoded" />
        </com.github.andreyasadchy.xtra.ui.player.FloatingChatCardView>

        <!-- A tucked chat leaves this tab at the screen edge. -->
        <LinearLayout
            android:id="@+id/floatingChatTab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|left"
            android:contentDescription="@string/floating_chat_show"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            tools:ignore="RtlHardcoded,UseCompoundDrawables">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_chat_24"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/floatingChatTabCount"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="12"
                tools:visibility="visible" />
        </LinearLayout>
    </com.github.andreyasadchy.xtra.ui.player.FloatingChatHostLayout>
    <!-- Player-owned, but outside the 16:9 PlayerLayout so portrait menus can
         use the space over chat. Above floating chat while a menu is open. -->
    <include
        android:id="@+id/playerPopupHost"
        layout="@layout/layout_player_popup_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="24dp"
        android:visibility="gone" />
</RelativeLayout>
