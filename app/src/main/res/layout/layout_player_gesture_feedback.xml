<?xml version="1.0" encoding="utf-8"?>
<!-- Gesture feedback over video. Only one child shows at a time:
     the top pill (plain messages), the top slider (seek, speed and pinch),
     the edge slider (brightness on the left, volume on the right) or, in the
     "number in the center" style, the centered value for every gesture.
     Colors are applied in code from PlayerPanelTheme.gestureFeedback. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/feedbackContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_gesture_feedback"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/feedbackIconBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_gesture_feedback_badge">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/feedbackIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_volume_up_black_24"
                tools:ignore="ContentDescription" />

        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/feedbackProgress"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:indicatorTrackGapSize="4dp"
            app:trackCornerRadius="3dp"
            app:trackStopIndicatorSize="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:text="100%" />

    </LinearLayout>

    <com.github.andreyasadchy.xtra.ui.player.PlayerGestureLevelView
        android:id="@+id/feedbackLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|left"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:ignore="RtlHardcoded" />

    <com.github.andreyasadchy.xtra.ui.player.PlayerGestureSliderView
        android:id="@+id/feedbackSlider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <com.github.andreyasadchy.xtra.ui.player.PlayerGestureValueView
        android:id="@+id/feedbackValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
