<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/spoiler_shield"
        app:iconSpaceReserved="false">

        <Preference
            android:key="spoiler_shield_manage"
            android:title="@string/spoiler_shield_manage"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="spoiler_shield_hide_titles"
            android:title="@string/spoiler_shield_hide_titles"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="spoiler_shield_hide_thumbnails"
            android:title="@string/spoiler_shield_hide_thumbnails"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_group_videos"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="player_spoiler_free_vods"
            android:summary="@string/spoiler_free_vods_summary"
            android:title="@string/spoiler_free_vods"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
